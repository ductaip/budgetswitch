  "search_flight": {
    "description": "Search domestic VN flights",
    "description_vi": "Tìm chuyến bay nội địa",
    "domain": "travel",
    "parameters": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "description": "DD/MM/YYYY"
