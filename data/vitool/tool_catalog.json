    "parameters": {
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "initial_deposit": {
          "type": "number"
        },
        "term_months": {
          "type": "integer",
          "enum": [
            3,
            6,
            12,
            24,
            36
          ]
        }
      },
      "required": [
        "customer_id",
        "initial_deposit"
      ]
    }
  },
