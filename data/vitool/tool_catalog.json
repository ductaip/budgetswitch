{
  "_description": "BudgetSwitch tool catalog. 38 tools across 5 VN domains. W2 Day 1 expansion.",
  "_version": "0.2.0-w2",
  "_last_updated": "W2 Day 1",
  "_domains": [
    "banking",
    "public_services",
    "ecommerce",    
    "travel",
    "info_retrieval"
  ],
  "check_balance": {
    "description": "Check bank account balance",
    "description_vi": "Tra cứu số dư tài khoản",
    "domain": "banking",
    "parameters": {
      "type": "object",
      "properties": {
        "account_number": {
          "type": "string",
          "pattern": "^[0-9]{8,16}$"
        }
      },
      "required": [
        "account_number"
      ]
    }
  },
  "transfer_money": {
    "description": "Transfer money between accounts",
    "description_vi": "Chuyển khoản",
    "domain": "banking",
    "parameters": {
      "type": "object",
      "properties": {
        "from_account": {
          "type": "string"
        },
        "to_account": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "description": "VND"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "from_account",
        "to_account",
        "amount"
      ]
    }
  },
  "transaction_history": {
    "description": "Get recent transaction history",
    "description_vi": "Lịch sử giao dịch",
    "domain": "banking",
    "parameters": {
      "type": "object",
      "properties": {
        "account_number": {
          "type": "string"
        },
        "from_date": {
          "type": "string",
          "description": "DD/MM/YYYY"
        },
        "to_date": {
          "type": "string",
          "description": "DD/MM/YYYY"
        }
      },
      "required": [
        "account_number"
      ]
    }
  },
  "open_savings_account": {
    "description": "Open savings account",
    "description_vi": "Mở tài khoản tiết kiệm",
